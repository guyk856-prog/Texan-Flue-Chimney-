# Local demo only. Generate your own secrets/password before seeding.
DATABASE_URL=postgresql://texan:local-dev-only@127.0.0.1:5432/texan_flue?schema=public
DIRECT_URL=postgresql://texan:local-dev-only@127.0.0.1:5432/texan_flue?schema=public
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true
SEED_DEMO_PASSWORD=
PRIVATE_STORAGE_DIR=./private/uploads
MAIL_MODE=capture
MAIL_CAPTURE_DIR=./private/mail
# Production: MAIL_MODE=smtp; configure verified delivery and HTTPS.
SMTP_URL=
MAIL_FROM=

# PDF rendering: set this to a system Chromium path, or install the bundled browser.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Trust client IP headers only behind a proxy that replaces spoofed headers.
TRUST_PROXY=false

# Optional, server only. Organization AI assistance must also be enabled by ADMIN.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Hosted production requires vercel-blob; filesystem is for local development only.
STORAGE_DRIVER=filesystem
BLOB_READ_WRITE_TOKEN=
# Optional local check of the serverless PDF engine. Vercel selects it automatically.
PDF_RUNTIME=
BOOTSTRAP_TOKEN=
ERROR_WEBHOOK_TOKEN=
ERROR_WEBHOOK_URL=
RATE_LIMIT_DRIVER=memory

# Optional local backup; generate a separate random 32+ character passphrase.
BACKUP_PASSPHRASE=

{
  "name": "texan-flue-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && node scripts/build-pdf.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json README.md docs/PHASE-A-REPORT.md",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e:ai": "playwright test --config playwright.phase-d.config.ts",
    "build:vercel": "node scripts/deploy-migrate.mjs && npm run build",
    "db:bootstrap": "tsx scripts/bootstrap-production.ts",
    "backup": "node --import tsx scripts/backup.mjs",
    "restore:verify": "node scripts/restore-verify.mjs",
    "test:e2e:production": "playwright test --config playwright.phase-e.config.ts",
    "test:accessibility": "node scripts/accessibility.mjs",
    "maintenance": "node --import tsx scripts/maintenance.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.8.2",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
